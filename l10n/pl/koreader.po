#: ../assistant_prompts.lua:24
msgid   "This prompt creates a structured system for generating context-aware definitions of words or phrases from literature by analyzing the highlighted term within its surrounding text to provide nuanced explanations that capture both literal meaning and contextual significance."
msgstr  "Ten monit tworzy uporządkowany system generowania kontekstowych definicji słów lub zwrotów z literatury poprzez analizę podświetlonego terminu wraz z otaczającym go tekstem, dostarczając wyrafinowanych wyjaśnień oddających zarówno dosłowne znaczenie, jak i kontekstowe znaczenie."

#: ../assistant_prompts.lua:98
msgid   "This prompt acts as a dictionary for the highlighted text, to a word or phrase."
msgstr  "Ten prompt działa jak słownik dla podświetlonego tekstu, słowa lub frazy."

#: ../assistant_prompts.lua:104 ../assistant_quicknote.lua:101
msgid   "Quick Note"
msgstr  "Szybka notatka"

#: ../assistant_prompts.lua:105
msgid   "This button creates a quick note with highlighted text."
msgstr  "Ten przycisk tworzy szybką notatkę z zaznaczonym tekstem."

#: ../assistant_prompts.lua:110
msgid   "Vocabulary"
msgstr  "Słownictwo"

#: ../assistant_prompts.lua:113
msgid   "This prompt analyzes the vocabulary of the highlighted text, identifying complex words and providing definitions, synonyms, and usage examples."
msgstr  "Ten prompt analizuje słownictwo podświetlonego tekstu, wskazując trudne słowa i podając definicje, synonimy i przykłady użycia."

#: ../assistant_prompts.lua:130
msgid   "Grammar"
msgstr  "Gramatyka"

#: ../assistant_prompts.lua:133
msgid   "This prompt analyzes the grammar of the highlighted text, providing a detailed explanation of its structure and any grammatical errors."
msgstr  "Ten prompt analizuje gramatykę podświetlonego tekstu, szczegółowo opisując jego strukturę i ewentualne błędy."

#: ../assistant_prompts.lua:149
msgid   "Translate"
msgstr  "Przetłumacz"

#: ../assistant_prompts.lua:150
msgid   "This prompt translates the highlighted text to another language."
msgstr  "Ten prompt tłumaczy podświetlony tekst na inny język."

#: ../assistant_prompts.lua:171
msgid   "Summarize"
msgstr  "Podsumuj"

#: ../assistant_prompts.lua:173
msgid   "This prompt summarizes the highlighted text, capturing its main points and essential details."
msgstr  "Ten prompt podsumowuje podświetlony tekst, uwzględniając główne punkty i najważniejsze szczegóły."

#: ../assistant_prompts.lua:182
msgid   "Simplify"
msgstr  "Uprość"

#: ../assistant_prompts.lua:184
msgid   "This prompt simplifies the highlighted text to make it easier to understand."
msgstr  "Ten prompt upraszcza podświetlony tekst, ułatwiając jego zrozumienie."

#: ../assistant_prompts.lua:195
msgid   "Key Points"
msgstr  "Kluczowe punkty"

#: ../assistant_prompts.lua:198
msgid   "This prompt extracts and lists the key points from the highlighted text, ensuring clarity and organization."
msgstr  "Ten prompt wydobywa i wypisuje kluczowe punkty z podświetlonego tekstu, zapewniając klarowność i porządek."

#: ../assistant_prompts.lua:210
msgid   "ELI5"
msgstr  "Wytłumacz jak 5-latkowi"

#: ../assistant_prompts.lua:213
msgid   "This prompt explains the highlighted text as if to a five-year-old, simplifying complex concepts into easily understandable terms."
msgstr  "Ten prompt wyjaśnia podświetlony tekst tak, jakby rozmawiał z pięciolatkiem, upraszczając złożone pojęcia."

#: ../assistant_prompts.lua:226
msgid   "Explain"
msgstr  "Wyjaśnij"

#: ../assistant_prompts.lua:228
msgid   "This prompt explains the highlighted text in detail, ensuring clarity and understanding."
msgstr  "Ten prompt szczegółowo wyjaśnia podświetlony tekst, zapewniając jasność i zrozumienie."

#: ../assistant_prompts.lua:239
msgid   "Historical Context"
msgstr  "Kontekst historyczny"

#: ../assistant_prompts.lua:242
msgid   "This prompt provides a detailed historical context for the highlighted text, explaining its significance and background."
msgstr  "Ten prompt dostarcza szczegółowego kontekstu historycznego dla podświetlonego tekstu, wyjaśniając jego znaczenie i tło."

#: ../assistant_prompts.lua:254 ../main.lua:668
msgid   "Wikipedia"
msgstr  "Wikipedia"

#: ../assistant_prompts.lua:257
msgid   "This prompt generates a comprehensive Wikipedia-style article based on the highlighted text, ensuring factual accuracy and neutrality."
msgstr  "Ten prompt tworzy obszerny artykuł w stylu Wikipedii na podstawie podświetlonego tekstu, zachowując faktograficzną dokładność i neutralność."

